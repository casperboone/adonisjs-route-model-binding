{
  "name": "@adonisjs/route-model-binding",
  "description": "Route model binding for AdonisJS",
  "version": "3.0.0-0",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "build/index.js",
  "type": "module",
  "files": [
    "build",
    "!build/bin",
    "!build/tests",
    "!build/examples",
    "!build/test_helpers"
  ],
  "exports": {
    ".": "./build/index.js",
    "./rmb_provider": "./build/providers/rmb_provider.js",
    "./rmb_middleware": "./build/src/rmb_middleware.js",
    "./types": "./build/src/types.js"
  },
  "scripts": {
    "build": "npm run compile",
    "precompile": "npm run clean",
    "compile": "tsup-node && tsc --emitDeclarationOnly --declaration",
    "clean": "del-cli build",
    "prepare": "npm run compile",
    "format": "prettier --write .",
    "lint": "eslint .",
    "pretest": "npm run lint",
    "quick:test": "node --enable-source-maps --import=@poppinss/ts-exec bin/test.ts",
    "test": "c8 npm run quick:test",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adonisjs/route-model-binding.git"
  },
  "keywords": [
    "rmb",
    "route-model-binding",
    "route-model",
    "adonisjs"
  ],
  "author": "virk,adonisjs",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/adonisjs/route-model-binding/issues"
  },
  "homepage": "https://github.com/adonisjs/route-model-binding#readme",
  "dependencies": {
    "@adonisjs/fold": "^11.1.1",
    "@poppinss/utils": "^7.1.2"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.6.0",
    "@adonisjs/core": "^7.6.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/runner": "^5.4.0",
    "@poppinss/ts-exec": "^1.5.1",
    "@types/node": "^24.19.2",
    "better-sqlite3": "^13.0.3",
    "c8": "^12.0.0",
    "del-cli": "^8.0.1",
    "eslint": "^9.39.5",
    "luxon": "^3.7.2",
    "prettier": "^3.9.10",
    "reflect-metadata": "^0.2.2",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/lucid": "^22.0.0"
  },
  "prettier": "@adonisjs/prettier-config",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  },
  "tsup": {
    "entry": [
      "./index.ts",
      "./src/types.ts",
      "./src/rmb_middleware.ts",
      "./providers/rmb_provider.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "dts": false,
    "sourcemap": true,
    "target": "esnext"
  }
}
